              "blocks": [
                {
                  "type": "paragraph",
                  "runs": [
                    {
                      "type": "text",
                      "text": "如图，直角三角形 ABC，"
                    },
                    {
                      "type": "math",
                      "latex": "\\angle A=90^{\\circ}"
                    },
                    {
                      "type": "text",
                      "text": "。求 BC 的长及 "
                    },
                    {
                      "type": "math",
                      "latex": "\\tan  B"
                    },
                    {
                      "type": "text",
                      "text": "。"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "runs": [
                    {
                      "type": "text",
                      "text": "图示 A 在左下、B 在右下、C 在左上；AB 边标 4，AC 边标 3。"
                    }
                  ]
                },
                {
                  "type": "image",
                  "fileId": "bd46323b-b78b-4ad7-9b64-ff0ea1213d1f",
                  "alt": "原稿配图",
                  "widthMm": 100
                }
              ]
            },
            "solution": {
              "version": 2,
              "blocks": [
                {
                  "type": "paragraph",
                  "runs": [
                    {
                      "type": "text",
                      "text": "答案 "
                    },
                    {
                      "type": "math",
                      "latex": "BC=5"
                    },
                    {
                      "type": "text",
                      "text": "，"
                    },
                    {
                      "type": "math",
                      "latex": "\\tan  B=\\frac{3}{4}"
                    },
                    {
                      "type": "text",
                      "text": "；由勾股定理和正切定义得到。"
                    }
                  ]
                }
              ]
            },
