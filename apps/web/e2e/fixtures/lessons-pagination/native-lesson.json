          "snapshot": {
            "title": "固定六题 Q1",
            "body": {
              "version": 2,
              "blocks": [
                {
                  "type": "paragraph",
                  "runs": [
                    {
                      "type": "text",
                      "text": "求函数 "
                    },
                    {
                      "type": "math",
                      "latex": "f(x)=\\frac{\\sqrt{2x-1}}{x-2}"
                    },
                    {
                      "type": "text",
                      "text": " 的定义域。"
                    }
                  ]
                },
                {
                  "type": "list",
                  "role": "options",
                  "items": [
                    {
                      "label": "A",
                      "blocks": [
                        {
                          "type": "paragraph",
                          "runs": [
                            {
                              "type": "math",
                              "latex": "[\\frac{1}{2},+\\infty )"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "B",
                      "blocks": [
                        {
                          "type": "paragraph",
                          "runs": [
                            {
                              "type": "math",
                              "latex": "[\\frac{1}{2},2)\\cup (2,+\\infty )"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "C",
                      "blocks": [
                        {
                          "type": "paragraph",
                          "runs": [
                            {
                              "type": "math",
                              "latex": "(\\frac{1}{2},2)\\cup (2,+\\infty )"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "D",
                      "blocks": [
                        {
                          "type": "paragraph",
                          "runs": [
                            {
                              "type": "math",
                              "latex": "(-\\infty ,2)\\cup (2,+\\infty )"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "solution": {
              "version": 2,
              "blocks": [
                {
                  "type": "paragraph",
                  "runs": [
                    {
                      "type": "text",
                      "text": "答案 B。根号内非负且分母不为零。"
                    }
                  ]
                }
              ]
            },
            "answerStatus": "present"
          }
        },
        {
          "kind": "question",
          "note": "C22教师注记-勿发学生",
          "snapshot": {
            "title": "固定六题 Q2",
            "body": {
              "version": 2,
              "blocks": [
                {
                  "type": "paragraph",
                  "runs": [
                    {
                      "type": "text",
                      "text": "已知 "
                    },
                    {
                      "type": "math",
                      "latex": "f(x)={x}^{2}-2x-3"
                    },
                    {
                      "type": "text",
                      "text": "，配坐标轴与抛物线图，标出顶点和两个横轴交点。"
                    }
                  ]
                },
                {
                  "type": "list",
                  "role": "subquestions",
                  "items": [
                    {
                      "label": "1",
                      "blocks": [
                        {
                          "type": "paragraph",
                          "runs": [
                            {
                              "type": "text",
                              "text": "求零点"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "2",
                      "blocks": [
                        {
                          "type": "paragraph",
                          "runs": [
                            {
                              "type": "text",
                              "text": "写出单调递增区间。"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "runs": [
                    {
                      "type": "text",
                      "text": "图中红点为 "
                    },
                    {
                      "type": "math",
                      "latex": "(-1,0)"
                    },
                    {
                      "type": "text",
                      "text": "、"
                    },
                    {
                      "type": "math",
                      "latex": "(1,-4)"
                    },
                    {
                      "type": "text",
                      "text": "、"
                    },
                    {
                      "type": "math",
                      "latex": "(3,0)"
                    },
                    {
                      "type": "text",
                      "text": "。"
                    }
                  ]
                },
                {
                  "type": "image",
                  "fileId": "94ce89e9-d524-4917-83ba-ca3b78096041",
                  "alt": "原稿配图",
                  "widthMm": 100
                }
              ]
            },
            "solution": {
              "version": 2,
              "blocks": [
                {
                  "type": "paragraph",
                  "runs": [
                    {
                      "type": "text",
                      "text": "解析 "
                    },
                    {
                      "type": "math",
                      "latex": "f(x)=(x-1)^{2}-4"
                    },
                    {
                      "type": "text",
                      "text": "；零点为 −1、3；单调递增区间为 "
                    },
                    {
                      "type": "math",
                      "latex": "[1,+\\infty )"
                    },
                    {
                      "type": "text",
                      "text": "。"
                    }
                  ]
                }
              ]
            },
            "answerStatus": "present"
          }
        },
        {
          "kind": "question",
          "note": "C22教师注记-勿发学生",
          "snapshot": {
            "title": "固定六题 Q3",
            "body": {
              "version": 2,
              "blocks": [
                {
                  "type": "paragraph",
                  "runs": [
                    {
                      "type": "math",
                      "latex": "f(x)=\\begin{cases}ax+1 & x<0 \\\\ {x}^{2}-1 & x\\ge 0\\end{cases}"
                    },
                    {
                      "type": "text",
                      "text": "。若 "
                    },
                    {
                      "type": "math",
                      "latex": "f(-2)=3"
                    },
                    {
                      "type": "text",
                      "text": "，求 a 和 "
                    },
                    {
                      "type": "math",
                      "latex": "f(1)"
                    },
                    {
                      "type": "text",
                      "text": "。"
                    }
                  ]
                }
              ]
            },
            "solution": {
              "version": 2,
              "blocks": [
                {
                  "type": "paragraph",
                  "runs": [
                    {
                      "type": "text",
                      "text": "答案 "
                    },
                    {
                      "type": "math",
                      "latex": "a=-1"
                    },
                    {
                      "type": "text",
                      "text": "，"
                    },
                    {
                      "type": "math",
                      "latex": "f(1)=0"
                    },
                    {
                      "type": "text",
                      "text": "。代入负数分支求 a，再代入非负分支。"
                    }
                  ]
                }
              ]
            },
            "answerStatus": "present"
          }
        },
        {
          "kind": "question",
          "note": "C22教师注记-勿发学生",
          "snapshot": {
            "title": "固定六题 Q4",
            "body": {
              "version": 2,
              "blocks": [
                {
                  "type": "paragraph",
                  "runs": [
                    {
                      "type": "text",
                      "text": "解不等式 "
                    },
                    {
                      "type": "math",
                      "latex": "\\log _{2}(x-1)\\le 1"
                    },
                    {
                      "type": "text",
                      "text": "。"
                    }
                  ]
                }
              ]
            },
            "solution": {
              "version": 2,
              "blocks": [
                {
                  "type": "paragraph",
                  "runs": [
                    {
                      "type": "text",
                      "text": "先有 "
                    },
                    {
                      "type": "math",
                      "latex": "x>1"
                    },
                    {
                      "type": "text",
                      "text": "，底数 2 大于 1，故 "
                    },
                    {
                      "type": "math",
                      "latex": "x-1\\le 2"
                    },
                    {
                      "type": "text",
                      "text": "，答案 "
                    },
                    {
                      "type": "math",
                      "latex": "1<x\\le 3"
                    },
                    {
                      "type": "text",
                      "text": "。"
                    }
                  ]
                }
              ]
            },
            "answerStatus": "present"
          }
        },
        {
          "kind": "question",
