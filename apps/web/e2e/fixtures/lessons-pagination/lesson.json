        {
          "id": "0f7e6a75-440e-413a-84a8-386363eb563a",
          "kind": "question",
          "questionId": "9178c876-be1e-4498-8da9-328660c2eca8",
          "questionVersion": 1,
          "note": "",
          "snapshot": {
            "title": "W-Q2 独立材料",
            "body": {
              "version": 2,
              "blocks": [
                {
                  "type": "paragraph",
                  "runs": [
                    {
                      "type": "text",
                      "text": "已知 "
                    },
                    {
                      "type": "math",
                      "latex": "f(x)={x}^{2}-2x-3"
                    },
                    {
                      "type": "text",
                      "text": "，配坐标轴与抛物线图，标出顶点和两个横轴交点。"
                    }
                  ]
                },
                {
                  "type": "list",
                  "role": "subquestions",
                  "items": [
                    {
                      "label": "1",
                      "blocks": [
                        {
                          "type": "paragraph",
                          "runs": [
                            {
                              "type": "text",
                              "text": "求零点"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "2",
                      "blocks": [
                        {
                          "type": "paragraph",
                          "runs": [
                            {
                              "type": "text",
                              "text": "写出单调递增区间。"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "runs": [
                    {
                      "type": "text",
                      "text": "图中红点为 "
                    },
                    {
                      "type": "math",
                      "latex": "(-1,0)"
                    },
                    {
                      "type": "text",
                      "text": "、"
                    },
                    {
                      "type": "math",
                      "latex": "(1,-4)"
                    },
                    {
                      "type": "text",
                      "text": "、"
                    },
                    {
                      "type": "math",
                      "latex": "(3,0)"
                    },
                    {
                      "type": "text",
                      "text": "。"
                    }
                  ]
                },
                {
                  "type": "image",
                  "fileId": "94ce89e9-d524-4917-83ba-ca3b78096041",
                  "alt": "原稿配图",
                  "widthMm": 100
                }
              ]
            },
            "solution": {
              "version": 2,
              "blocks": [
                {
                  "type": "paragraph",
                  "runs": [
                    {
                      "type": "text",
                      "text": "解析 "
                    },
                    {
                      "type": "math",
                      "latex": "f(x)=(x-1)^{2}-4"
                    },
                    {
                      "type": "text",
                      "text": "；零点为 −1、3；单调递增区间为 "
                    },
                    {
                      "type": "math",
                      "latex": "[1,+\\infty )"
                    },
                    {
                      "type": "text",
                      "text": "。"
                    }
                  ]
                }
              ]
            },
            "answerStatus": "present"
          },
          "latestVersion": 1,
          "sourceState": "active"
        },
        {
          "id": "15ef4f47-75fd-4fd0-bd21-3f2b53ba3355",
          "kind": "question",
          "questionId": "1a84c476-ebb9-4b04-9fd6-b9d87d315dd9",
          "questionVersion": 1,
          "note": "",
          "snapshot": {
            "title": "W-Q3 独立材料",
            "body": {
              "version": 2,
              "blocks": [
                {
                  "type": "paragraph",
                  "runs": [
                    {
                      "type": "math",
                      "latex": "f(x)=\\begin{cases}ax+1 & x<0 \\\\ {x}^{2}-1 & x\\ge 0\\end{cases}"
                    },
                    {
                      "type": "text",
                      "text": "。若 "
                    },
                    {
                      "type": "math",
                      "latex": "f(-2)=3"
                    },
                    {
                      "type": "text",
                      "text": "，求 a 和 "
                    },
                    {
                      "type": "math",
                      "latex": "f(1)"
                    },
                    {
                      "type": "text",
                      "text": "。"
                    }
                  ]
                }
              ]
            },
            "solution": {
              "version": 2,
              "blocks": [
                {
                  "type": "paragraph",
                  "runs": [
                    {
                      "type": "text",
                      "text": "答案 "
                    },
                    {
                      "type": "math",
                      "latex": "a=-1"
                    },
                    {
                      "type": "text",
                      "text": "，"
                    },
                    {
                      "type": "math",
                      "latex": "f(1)=0"
                    },
                    {
                      "type": "text",
                      "text": "。代入负数分支求 a，再代入非负分支。"
                    }
                  ]
                }
              ]
            },
            "answerStatus": "present"
          },
          "latestVersion": 1,
          "sourceState": "active"
        },
        {
          "id": "4027a6b0-1a85-47a9-827d-a668042b4f78",
          "kind": "question",
          "questionId": "c785a665-a5fd-413b-a19b-81fe784a36e8",
          "questionVersion": 1,
          "note": "",
          "snapshot": {
            "title": "W-Q4 独立材料",
            "body": {
              "version": 2,
              "blocks": [
                {
                  "type": "paragraph",
                  "runs": [
                    {
                      "type": "text",
                      "text": "解不等式 "
                    },
                    {
                      "type": "math",
                      "latex": "\\log _{2}(x-1)\\le 1"
                    },
                    {
                      "type": "text",
                      "text": "。"
                    }
                  ]
                }
              ]
            },
            "solution": {
              "version": 2,
              "blocks": [
                {
                  "type": "paragraph",
                  "runs": [
                    {
                      "type": "text",
                      "text": "先有 "
                    },
                    {
                      "type": "math",
                      "latex": "x>1"
                    },
                    {
                      "type": "text",
                      "text": "，底数 2 大于 1，故 "
                    },
                    {
                      "type": "math",
                      "latex": "x-1\\le 2"
                    },
                    {
                      "type": "text",
                      "text": "，答案 "
                    },
                    {
                      "type": "math",
                      "latex": "1<x\\le 3"
                    },
                    {
                      "type": "text",
                      "text": "。"
                    }
                  ]
                }
              ]
            },
            "answerStatus": "present"
          },
          "latestVersion": 1,
          "sourceState": "active"
        },
        {
          "id": "0704848b-19ff-4806-8394-7fd9515ed9ac",
          "kind": "question",
          "questionId": "baf759cf-69e8-47b3-aeee-92ee7b63142b",
          "questionVersion": 1,
          "note": "",
          "snapshot": {
            "title": "W-Q5 独立材料",
            "body": {
              "version": 2,
              "blocks": [
                {
                  "type": "paragraph",
                  "runs": [
                    {
                      "type": "text",
                      "text": "如图，直角三角形 ABC，"
                    },
                    {
                      "type": "math",
                      "latex": "\\angle A=90^{\\circ}"
                    },
                    {
                      "type": "text",
                      "text": "。求 BC 的长及 "
                    },
                    {
                      "type": "math",
                      "latex": "\\tan  B"
                    },
                    {
                      "type": "text",
                      "text": "。"
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "runs": [
                    {
                      "type": "text",
                      "text": "图示 A 在左下、B 在右下、C 在左上；AB 边标 4，AC 边标 3。"
                    }
                  ]
                },
                {
                  "type": "image",
                  "fileId": "bd46323b-b78b-4ad7-9b64-ff0ea1213d1f",
                  "alt": "原稿配图",
                  "widthMm": 100
                }
              ]
            },
            "solution": {
              "version": 2,
              "blocks": [
                {
                  "type": "paragraph",
                  "runs": [
                    {
                      "type": "text",
                      "text": "答案 "
                    },
                    {
                      "type": "math",
                      "latex": "BC=5"
                    },
                    {
                      "type": "text",
                      "text": "，"
                    },
                    {
                      "type": "math",
                      "latex": "\\tan  B=\\frac{3}{4}"
                    },
                    {
                      "type": "text",
                      "text": "；由勾股定理和正切定义得到。"
                    }
                  ]
                }
              ]
            },
            "answerStatus": "present"
          },
          "latestVersion": 1,
          "sourceState": "active"
        },
