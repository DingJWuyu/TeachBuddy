          "snapshot": {
            "title": "W-Q1 独立材料",
            "body": {
              "version": 2,
              "blocks": [
                {
                  "type": "paragraph",
                  "runs": [
                    {
                      "type": "text",
                      "text": "求函数 "
                    },
                    {
                      "type": "math",
                      "latex": "f(x)=\\frac{\\sqrt{2x-1}}{x+2}"
                    },
                    {
                      "type": "text",
                      "text": " 的定义域。"
                    }
                  ]
                },
                {
                  "type": "list",
                  "role": "options",
                  "items": [
                    {
                      "label": "A",
                      "blocks": [
                        {
                          "type": "paragraph",
                          "runs": [
                            {
                              "type": "math",
                              "latex": "[\\frac{1}{2},+\\infty )"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "B",
                      "blocks": [
                        {
                          "type": "paragraph",
                          "runs": [
                            {
                              "type": "math",
                              "latex": "[\\frac{1}{2},2)\\cup (2,+\\infty )"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "C",
                      "blocks": [
                        {
                          "type": "paragraph",
                          "runs": [
                            {
                              "type": "math",
                              "latex": "(\\frac{1}{2},2)\\cup (2,+\\infty )"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "D",
                      "blocks": [
                        {
                          "type": "paragraph",
                          "runs": [
                            {
                              "type": "math",
                              "latex": "(-\\infty ,2)\\cup (2,+\\infty )"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "solution": {
              "version": 2,
              "blocks": [
                {
                  "type": "paragraph",
                  "runs": [
                    {
                      "type": "text",
                      "text": "答案 B。根号内非负且分母不为零。"
                    }
                  ]
                }
              ]
            },
            "answerStatus": "present"
          },
