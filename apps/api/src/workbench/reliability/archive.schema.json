{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Personal export and deployment backup formats, validated through schema.js. Conversation payloads retain their existing native public schema.",
  "$defs": {
    "DeploymentManifest": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "teachbuddy-deployment"
        },
        "formatVersion": {
          "const": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "productRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileEntry"
          }
        },
        "backupId": {
          "type": "string",
          "format": "uuid"
        },
        "database": {
          "$ref": "#/$defs/FileEntry"
        },
        "migrationIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "备份时完整有序的迁移账本。恢复时与实际库和本版本支持的迁移集合逐项核对，出现未知模块、未知迁移 ID 或缺少升级链即停止。"
        },
        "schemas": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "version"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "formatVersion",
        "createdAt",
        "productRevision",
        "files",
        "backupId",
        "database",
        "migrationIds",
        "schemas"
      ],
      "additionalProperties": false,
      "description": "部署备份清单，记录备份时的事实，不含秘密，也不含可复用的认证清理或开放许可。schemas 列出库中全部必需的内容、数学和助理格式版本，版本未知即停止恢复；认证清理成功本身不足以开放恢复副本。"
    },
    "PortableManifest": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "teachbuddy-personal"
        },
        "formatVersion": {
          "const": 1
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "productRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FileEntry"
          }
        },
        "accountLabel": {
          "type": "string"
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PortableObject"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Relation"
          }
        },
        "excluded": {
          "const": [
            "authentication",
            "secrets",
            "device-drafts",
            "device-scenes",
            "raw-agent-runtime",
            "export-cache"
          ]
        }
      },
      "required": [
        "kind",
        "formatVersion",
        "createdAt",
        "productRevision",
        "files",
        "accountLabel",
        "objects",
        "relations",
        "excluded"
      ],
      "additionalProperties": false
    },
    "ObjectKey": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "question",
            "question-taxonomy",
            "import",
            "resource",
            "resource-taxonomy",
            "resource-file-revision",
            "math",
            "entry",
            "notification",
            "conversation",
            "preferences",
            "layout",
            "schedule-settings",
            "file",
            "job",
            "math-revision",
            "classroom-class",
            "classroom-student",
            "classroom-record",
            "classroom-exam",
            "classroom-result",
            "classroom-import",
            "classroom-tag"
          ]
        },
        "id": {
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "id",
        "version"
      ],
      "additionalProperties": false
    },
    "Relation": {
      "type": "object",
      "properties": {
        "from": {
          "$ref": "#/$defs/ObjectKey"
        },
        "to": {
          "$ref": "#/$defs/ObjectKey"
        },
        "relation": {
          "enum": [
            "copy-source",
            "origin",
            "reference-snapshot",
            "current-link",
            "conversation-reference",
            "exception",
            "class-student",
            "record-subject",
            "exam-source",
            "exam-tag",
            "result-exam",
            "result-class",
            "result-student",
            "import-file",
            "import-exam",
            "import-class",
            "import-result"
          ]
        },
        "adoptedVersion": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to",
        "relation",
        "adoptedVersion",
        "location"
      ],
      "additionalProperties": false
    },
    "FileEntry": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mediaType": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256",
        "mediaType",
        "displayName"
      ],
      "additionalProperties": false
    },
    "PortableObject": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/ObjectKey"
        },
        "state": {
          "enum": [
            "active",
            "deleted"
          ]
        },
        "dataPath": {
          "type": "string"
        },
        "readablePath": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "state",
        "dataPath",
        "readablePath"
      ],
      "additionalProperties": false
    },
    "Export": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "ready",
            "failed",
            "interrupted"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "snapshotAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "downloadPath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "problem": {
          "anyOf": [
            {
              "$ref": "#/$defs/Problem"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "state",
        "createdAt",
        "snapshotAt",
        "completedAt",
        "downloadPath",
        "problem"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "ready"
              }
            }
          },
          "then": {
            "properties": {
              "downloadPath": {
                "type": "string",
                "pattern": "^/api/reliability/v1/exports/[0-9a-f-]+/content$"
              },
              "completedAt": {
                "$ref": "#/$defs/Timestamp"
              },
              "problem": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "downloadPath": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "failed",
                  "interrupted"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "problem": {
                "$ref": "#/$defs/Problem"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "ready",
                  "failed",
                  "interrupted"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "completedAt": {
                "$ref": "#/$defs/Timestamp"
              }
            }
          },
          "else": {
            "properties": {
              "completedAt": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "ExportList": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Export"
          }
        }
      },
      "required": [
        "items"
      ]
    },
    "Problem": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "/problems/reliability/unsupported-agent-version"
            },
            "status": {
              "const": 422
            },
            "title": {
              "type": "string"
            },
            "field": {
              "type": "string"
            },
            "currentVersion": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "status",
            "title"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "/problems/reliability/preference-conflict"
            },
            "status": {
              "const": 409
            },
            "title": {
              "type": "string"
            },
            "field": {
              "type": "string"
            },
            "currentVersion": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "status",
            "title",
            "currentVersion"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "/problems/reliability/archive-not-ready"
            },
            "status": {
              "const": 409
            },
            "title": {
              "type": "string"
            },
            "field": {
              "type": "string"
            },
            "currentVersion": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "status",
            "title"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "/problems/reliability/archive-invalid"
            },
            "status": {
              "const": 422
            },
            "title": {
              "type": "string"
            },
            "field": {
              "type": "string"
            },
            "currentVersion": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "status",
            "title"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "/problems/reliability/archive-incompatible"
            },
            "status": {
              "const": 422
            },
            "title": {
              "type": "string"
            },
            "field": {
              "type": "string"
            },
            "currentVersion": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "status",
            "title"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "/problems/reliability/recovery-review-required"
            },
            "status": {
              "const": 409
            },
            "title": {
              "type": "string"
            },
            "field": {
              "type": "string"
            },
            "currentVersion": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "status",
            "title"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "/problems/reliability/temporarily-unavailable"
            },
            "status": {
              "const": 503
            },
            "title": {
              "type": "string"
            },
            "field": {
              "type": "string"
            },
            "currentVersion": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "type",
            "status",
            "title"
          ]
        }
      ]
    },
    "Context": {
      "type": "object",
      "properties": {
        "recoveryId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "recoveryId"
      ]
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
