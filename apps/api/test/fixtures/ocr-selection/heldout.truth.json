          ]
        },
        {
          "id": "H2-b12",
          "text": "当角 α 的终边在第一象限时，点 P 在第一象限，，所以，",
          "bbox": [
            364,
            1468,
            1374,
            1522
          ]
        },
        {
          "id": "H2-b13",
          "text": "当角 α 的终边在第二象限时，点 P 在第二象限，，所以，",
          "bbox": [
