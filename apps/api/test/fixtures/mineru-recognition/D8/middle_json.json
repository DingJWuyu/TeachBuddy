          ],
          "content": [
            {
              "type": "text",
              "content": "判断并说明:若第二项与第五项已知，是否能唯一确定一个等差数列？"
            }
          ]
        },
        {
          "type": "equation",
          "index": 15,
          "bbox": [
            0.067,
            0.664,
            0.39,
            0.679
          ],
          "image_path": "images/page_0_equation_15.jpg",
          "content": "a _ {2} = 7, \\quad a _ {5} = 1 9 \\Longrightarrow d = 4, \\quad a _ {1} = 3"
        },
        {
          "type": "text",
          "index": 16,
          "bbox": [
            0.065,
