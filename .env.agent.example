# Command Code Provider API - copy to .env.agent or .env and fill only the key.
COMMANDCODE_API_KEY=
COMMANDCODE_BASE_URL=https://api.commandcode.ai/provider/v1
COMMANDCODE_PROVIDER=commandcode
COMMANDCODE_API=openai-completions
COMMANDCODE_MODEL=deepseek/deepseek-v4.1-flash
COMMANDCODE_ALLOWED_MODELS=deepseek/deepseek-v4.1-flash,z-ai/glm-5.3-flash
