{
  "$schema": "https://unpkg.com/release-it/schema/release-it.json",
  "git": {
    "requireBranch": "preview/integration",
    "requireUpstream": false,
    "commit": false,
    "tag": false,
    "push": false
  },
  "npm": { "publish": false },
  "github": { "release": false },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": { "name": "conventionalcommits" },
      "infile": "CHANGELOG.md"
    }
  }
}
