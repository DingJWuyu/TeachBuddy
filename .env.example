# Copy to .env, fill local paths and secrets, then run npm run dev.
# For a built deployment, use NODE_ENV=production and npm run build first.
NODE_ENV=development
PORT=4443
SQLITE_PATH=/absolute/persistent/teachbuddy.sqlite
WORKBENCH_FILES_DIR=/absolute/persistent/teachbuddy-files
WORKBENCH_LOG_DIR=/absolute/persistent/teachbuddy-logs
WORKBENCH_PUBLIC_ORIGIN=https://localhost:4443
WORKBENCH_TLS_CERT=/absolute/path/cert.pem
WORKBENCH_TLS_KEY=/absolute/path/key.pem
WORKBENCH_WEB_DIST=apps/web/dist
# Required persistent secret. Generate outside the repository; keep file mode 600.
AUTH_CODE_SECRET=
AUTH_REGISTRATION_OPEN=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Optional Agent provider; only the two existing server-side model IDs are allowed.
COMMANDCODE_API_KEY=
COMMANDCODE_BASE_URL=https://api.commandcode.ai/provider/v1

# Optional file conversion tools; otherwise the corresponding formats are unavailable.
# MATERIALS_PANDOC_PATH=/absolute/tools/pandoc/bin/pandoc
# MATERIALS_OFFICE_ROOT=/absolute/tools/libreoffice
# QUESTIONS_XPDF_PDFTOHTML=/absolute/tools/xpdf/bin64/pdftohtml

# Optional local OCR. Pinned Python, models and manifest live outside the repository.
# See docs/SETUP.md before enabling; no automatic model download or online fallback.
# MATERIALS_OCR_HOME=/absolute/tools/paddleocr-vl-1.6-content-check
