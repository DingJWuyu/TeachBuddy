{
  "name": "teachbuddy",
  "private": true,
  "version": "0.3.0",
  "description": "A teacher workspace shell with account access, persistent layout, and a neutral module registration contract.",
  "license": "MIT",
  "author": "TeachBuddy contributors",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "node scripts/math-support/prepare-assets.mjs",
    "dev": "node --env-file-if-exists=.env --watch apps/api/src/server.js --dev",
    "prototype": "python3 -m http.server 4174 --bind 127.0.0.1 --directory docs/design-system/teachbuddy-app",
    "dev:web": "npm --workspace @teachbuddy/web run dev",
    "dev:api": "npm --workspace @teachbuddy/api run dev",
    "test:api": "npm --workspace @teachbuddy/api run test",
    "test:e2e": "playwright test --config=playwright.config.mjs",
    "build": "npm-run-all build:shared build:api build:web",
    "build:shared": "npm --workspace @teachbuddy/shared run build",
    "build:api": "npm --workspace @teachbuddy/api run build",
    "build:web": "npm --workspace @teachbuddy/web run build",
    "math:geogebra:build": "python3 scripts/math-support/geogebra-build.py",
    "test:agent": "node --test apps/api/test/rebuilt/agent.test.js",
    "test:agent:e2e": "playwright test -c apps/web/e2e/ci.config.mjs agent.spec.mjs",
    "review:agent": "node apps/api/test/fixtures/c26/serve.mjs",
    "test:ci": "node --test --test-concurrency=4 apps/api/test/rebuilt/*.test.js",
    "release:prepare": "release-it --config .release-it.json",
    "test:ci:outputs": "node --test --test-concurrency=1 apps/api/test/rebuilt-outputs/*.test.js extensions/math-web-ai/test/rebuilt/*.test.mjs",
    "test:ci:browser": "playwright test -c apps/web/e2e/ci.config.mjs",
    "test:auth:e2e": "playwright test -c apps/web/e2e/ci.config.mjs identity.spec.mjs",
    "check:static": "npm-run-all --continue-on-error check:unused lint",
    "check:unused": "knip",
    "lint": "oxlint --deny-warnings apps packages scripts extensions tools/geogebra/loader.js playwright.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@release-it/conventional-changelog": "12.0.2",
    "knip": "6.42.1",
    "npm-run-all": "^4.1.5",
    "oxlint": "1.89.0",
    "release-it": "21.1.1",
    "semver": "7.8.5",
    "sharp": "^0.35.5",
    "@fontsource/noto-sans-sc": "5.2.9",
    "@vitejs/plugin-react": "^5.2.0",
    "better-sqlite3": "^11.8.1",
    "jszip": "3.10.2",
    "mathjax": "3.2.2",
    "mathlive": "0.110.0",
    "vite": "^8.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zundo": "2.3.0"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12",
    "katex": "0.18.2"
  }
}
