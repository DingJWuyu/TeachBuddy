{
  "name": "refatos-v1",
  "private": true,
  "version": "0.3.0",
  "description": "A teacher workspace shell with account access, persistent layout, and a neutral module registration contract.",
  "license": "MIT",
  "author": "Robiul Islam Refat",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:api",
    "prototype:sidebar": "vite prototype --host 0.0.0.0 --port 4174 --strictPort",
    "prototype:build": "vite build prototype",
    "dev:web": "npm --workspace @refatos/web run dev",
    "dev:api": "npm --workspace @refatos/api run dev",
    "test:api": "npm --workspace @refatos/api run test",
    "test:e2e": "playwright test --config=playwright.config.mjs",
    "build": "npm-run-all build:shared build:api build:web",
    "build:shared": "npm --workspace @refatos/shared run build",
    "build:api": "npm --workspace @refatos/api run build",
    "build:web": "npm --workspace @refatos/web run build",
    "test:agent": "node --test apps/api/test/agent.test.js",
    "test:agent:e2e": "playwright test -c apps/web/e2e/c26/agent.config.mjs",
    "review:agent": "node apps/api/test/fixtures/c26/serve.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "npm-run-all": "^4.1.5"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.12"
  }
}
