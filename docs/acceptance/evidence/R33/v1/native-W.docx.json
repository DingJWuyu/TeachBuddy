        "blocks": [
          {
            "type": "paragraph",
            "runs": [
              {
                "type": "math",
                "latex": "f(x)={ax+1, x<0; {x}^{2}−1, x≥0}"
              },
              {
                "type": "text",
                "text": "。若 "
              },
              {
                "type": "math",
                "latex": "f(−2)=3"
              },
              {
                "type": "text",
                "text": "，求 a 和 f(1)。"
              }
            ]
          }
        ]
      },
      "solution": {
        "version": 2,
        "blocks": [
          {
            "type": "paragraph",
            "runs": [
              {
                "type": "text",
                "text": "答案 a=−1，f(1)=0。代入负数分支求 a，再代入非负分支。"
              }
            ]
          }
        ]
      },
