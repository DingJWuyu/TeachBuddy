          {
            "type": "paragraph",
            "runs": [
              {
                "type": "text",
                "text": "（1）求零点；（2）写出单调递增区间。"
              }
            ]
          },
          {
            "type": "paragraph",
            "runs": [
              {
                "type": "text",
                "text": "图中红点为 (−1,0)、(1,−4)、(3,0)。"
              }
            ]
          },
          {
            "type": "image",
