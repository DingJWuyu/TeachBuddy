          {
            "type": "paragraph",
            "runs": [
              {
                "type": "text",
                "text": "A. [1/2,+∞)    B. [1/2,2)∪(2,+∞)    C. (1/2,2)∪(2,+∞)    D. (−∞,2)∪(2,+∞)"
              }
            ]
          }
        ]
      },
      "solution": {
        "version": 2,
        "blocks": [
          {
            "type": "paragraph",
            "runs": [
              {
                "type": "text",
                "text": "答案 B。根号内非负且分母不为零。"
              }
            ]
          }
        ]
