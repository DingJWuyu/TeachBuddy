    {
      "id": "3cf18551-b34b-41bb-adb3-10263ceb2150",
      "title": "Q2",
      "body": {
        "version": 2,
        "blocks": [
          {
            "type": "paragraph",
            "runs": [
              {
                "type": "text",
                "text": "已知 "
              },
              {
                "type": "math",
                "latex": "f(x)=x^{2}-2x-3"
              },
              {
                "type": "text",
                "text": "，配坐标轴与抛物线图，标出顶点和两个横轴交点。(1) 求零点；(2) 写出单调递增区间。"
              }
            ]
          }
        ]
      },
      "solution": {
        "version": 2,
        "blocks": [
          {
            "type": "paragraph",
            "runs": [
              {
                "type": "text",
                "text": "解析 "
              },
              {
                "type": "math",
                "latex": "f(x)=(x-1)^{2}-4"
              },
              {
                "type": "text",
                "text": "；零点为 −1、3；单调递增区间为 "
              },
              {
                "type": "math",
                "latex": "[1,+\\infty )"
              },
              {
                "type": "text",
                "text": "。"
              }
            ]
          }
        ]
      },
      "answerStatus": "present",
