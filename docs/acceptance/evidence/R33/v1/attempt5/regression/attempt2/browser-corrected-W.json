                    ]
                  }
                ]
              },
              {
                "label": "C",
                "blocks": [
                  {
                    "type": "paragraph",
                    "runs": [
                      {
                        "type": "math",
                        "latex": "(\\frac{1}{2},2)\\cup (2,+\\infty )"
                      }
                    ]
                  }
                ]
              },
              {
                "label": "D",
                "blocks": [
                  {
                    "type": "paragraph",
                    "runs": [
                      {
                        "type": "math",
                        "latex": "(-\\infty ,2)\\cup (2,+\\infty )"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "solution": {
        "version": 2,
