    {
      "id": "f2c04fb2-f39b-487b-a8ca-fa53ce67ee9a",
      "title": "Q2.",
      "body": {
        "version": 2,
        "blocks": [
          {
            "type": "paragraph",
            "runs": [
              {
                "type": "text",
                "text": "已知 "
              },
              {
                "type": "math",
                "latex": "f(x)={x}^{2}-2x-3"
              },
              {
                "type": "text",
                "text": "，配坐标轴与抛物线图，标出顶点和两个横轴交点。"
              }
            ]
          },
          {
            "type": "list",
            "role": "subquestions",
            "items": [
              {
                "label": "1",
                "blocks": [
                  {
                    "type": "paragraph",
                    "runs": [
                      {
                        "type": "text",
                        "text": "求零点"
                      }
                    ]
                  }
                ]
              },
              {
                "label": "2",
                "blocks": [
                  {
                    "type": "paragraph",
                    "runs": [
                      {
                        "type": "text",
                        "text": "写出单调递增区间。"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "paragraph",
            "runs": [
              {
                "type": "text",
                "text": "图中红点为 "
              },
              {
                "type": "math",
                "latex": "(-1,0)"
              },
              {
                "type": "text",
                "text": "、"
              },
              {
                "type": "math",
                "latex": "(1,-4)"
              },
              {
                "type": "text",
                "text": "、"
              },
              {
                "type": "math",
                "latex": "(3,0)"
              },
              {
                "type": "text",
                "text": "。"
              }
            ]
          },
          {
            "type": "image",
            "fileId": "1eff5755-527d-46f6-b41f-13c16a628af3",
            "alt": "原稿配图",
            "widthMm": 100
          }
        ]
      },
      "solution": {
        "version": 2,
        "blocks": [
          {
            "type": "paragraph",
            "runs": [
              {
                "type": "text",
                "text": "解析 "
              },
              {
                "type": "math",
                "latex": "f(x)=(x-1)^{2}-4"
              },
              {
                "type": "text",
                "text": "；零点为 −1、3；单调递增区间为 "
              },
              {
                "type": "math",
                "latex": "[1,+\\infty )"
              },
              {
                "type": "text",
                "text": "。"
              }
            ]
          }
        ]
      },
