    {
      "id": "16f0066a-2932-4a23-ad93-c42a8b77fe91",
      "title": "Q3.",
      "body": {
        "version": 2,
        "blocks": [
          {
            "type": "paragraph",
            "runs": [
              {
                "type": "math",
                "latex": "f(x)=\\begin{cases}ax+1 & x<0 \\\\ {x}^{2}-1 & x\\ge 0\\end{cases}"
              },
              {
                "type": "text",
                "text": "。若 "
              },
              {
                "type": "math",
                "latex": "f(-2)=3"
              },
              {
                "type": "text",
                "text": "，求 a 和 "
              },
              {
                "type": "math",
                "latex": "f(1)"
              },
              {
                "type": "text",
                "text": "。"
              }
            ]
          }
        ]
      },
      "solution": {
        "version": 2,
        "blocks": [
          {
            "type": "paragraph",
            "runs": [
              {
                "type": "text",
                "text": "答案 "
              },
              {
                "type": "math",
                "latex": "a=-1"
              },
              {
                "type": "text",
                "text": "，"
              },
              {
                "type": "math",
                "latex": "f(1)=0"
              },
              {
                "type": "text",
                "text": "。代入负数分支求 a，再代入非负分支。"
              }
            ]
          }
        ]
      },
