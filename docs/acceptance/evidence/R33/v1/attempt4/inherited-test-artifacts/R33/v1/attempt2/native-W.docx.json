            "type": "paragraph",
            "runs": [
              {
                "type": "text",
                "text": "如图，直角三角形 ABC，"
              },
              {
                "type": "math",
                "latex": "\\angle A=90^{\\circ}"
              },
              {
                "type": "text",
                "text": "。求 BC 的长及 "
              },
              {
                "type": "math",
                "latex": "\\tan  B"
              },
              {
                "type": "text",
                "text": "。"
              }
            ]
          },
          {
            "type": "paragraph",
            "runs": [
              {
                "type": "text",
                "text": "图示 A 在左下、B 在右下、C 在左上；AB 边标 4，AC 边标 3。"
              }
