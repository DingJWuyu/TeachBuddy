                    ]
                  }
                ]
              },
              {
                "label": "B",
                "blocks": [
                  {
                    "type": "paragraph",
                    "runs": [
                      {
                        "type": "math",
                        "latex": "[\\frac{1}{2},2)\\cup (2,+\\infty )"
