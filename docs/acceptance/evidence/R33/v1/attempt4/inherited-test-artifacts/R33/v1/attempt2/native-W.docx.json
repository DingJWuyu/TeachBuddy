                "text": "先有 "
              },
              {
                "type": "math",
                "latex": "x>1"
              },
              {
                "type": "text",
                "text": "，底数 2 大于 1，故 "
              },
              {
                "type": "math",
                "latex": "x-1\\le 2"
              },
              {
                "type": "text",
                "text": "，答案 "
              },
              {
                "type": "math",
                "latex": "1<x\\le 3"
              },
              {
                "type": "text",
                "text": "。"
              }
            ]
          }
        ]
