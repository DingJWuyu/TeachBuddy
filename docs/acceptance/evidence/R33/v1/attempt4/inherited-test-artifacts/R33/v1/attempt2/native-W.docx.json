              },
              {
                "type": "text",
                "text": "，"
              },
              {
                "type": "math",
                "latex": "\\tan  B=\\frac{3}{4}"
              },
              {
                "type": "text",
                "text": "；由勾股定理和正切定义得到。"
              }
            ]
          }
