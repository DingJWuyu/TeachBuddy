            "runs": [
              {
                "type": "text",
                "text": "求函数 "
              },
              {
                "type": "math",
                "latex": "f(x)=\\frac{\\sqrt{2x-1}}{x+2}"
              },
              {
                "type": "text",
                "text": " 的定义域。"
              }
