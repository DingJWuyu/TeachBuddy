              },
              {
                "type": "math",
                "latex": "x-1\\le 2"
              },
              {
                "type": "text",
                "text": "，答案 "
              },
              {
                "type": "math",
                "latex": "1<x\\le 3"
              },
              {
                "type": "text",
                "text": "。"
              }
            ]
          }
        ]
