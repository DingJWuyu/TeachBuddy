    {
      "id": "17e2a23a-2c1b-44e8-af0e-1a6397acfe67",
      "title": "Q2.",
      "body": {
        "version": 2,
        "blocks": [
          {
            "type": "paragraph",
            "runs": [
              {
                "type": "text",
                "text": "已知 "
              },
              {
                "type": "math",
                "latex": "f(x)={x}^{2}-2x-3"
              },
              {
                "type": "text",
                "text": "，配坐标轴与抛物线图，标出顶点和两个横轴交点。"
              }
            ]
          },
          {
            "type": "list",
            "role": "subquestions",
            "items": [
              {
                "label": "1",
                "blocks": [
                  {
                    "type": "paragraph",
                    "runs": [
                      {
                        "type": "text",
                        "text": "求零点"
                      }
                    ]
                  }
                ]
              },
              {
                "label": "2",
                "blocks": [
                  {
                    "type": "paragraph",
                    "runs": [
                      {
                        "type": "text",
                        "text": "写出单调递增区间。"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "type": "paragraph",
            "runs": [
              {
                "type": "text",
                "text": "图中红点为 "
              },
              {
                "type": "math",
                "latex": "(-1,0)"
              },
              {
                "type": "text",
                "text": "、"
              },
              {
                "type": "math",
                "latex": "(1,-4)"
              },
              {
                "type": "text",
                "text": "、"
              },
              {
                "type": "math",
                "latex": "(3,0)"
              },
              {
                "type": "text",
                "text": "。"
              }
            ]
          },
          {
            "type": "image",
            "fileId": "108db08c-d52b-4b97-87ef-15561d0100f4",
            "alt": "原稿配图",
            "widthMm": 100
          }
        ]
      },
      "solution": {
        "version": 2,
        "blocks": [
          {
            "type": "paragraph",
            "runs": [
              {
                "type": "text",
                "text": "解析 "
              },
              {
                "type": "math",
                "latex": "f(x)=(x-1)^{2}-4"
              },
              {
                "type": "text",
                "text": "；零点为 −1、3；单调递增区间为 "
              },
              {
                "type": "math",
                "latex": "[1,+\\infty )"
              },
              {
                "type": "text",
                "text": "。"
              }
            ]
          }
        ]
      },
