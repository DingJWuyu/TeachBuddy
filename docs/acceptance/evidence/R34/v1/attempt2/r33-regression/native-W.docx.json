                "type": "math",
                "latex": "f(x)={ax+1, x<0; {x}^{2}−1, x≥0}"
              },
              {
                "type": "text",
                "text": "。若 "
              },
              {
                "type": "math",
                "latex": "f(−2)=3"
              },
