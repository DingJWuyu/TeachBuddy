          {
            "type": "paragraph",
            "runs": [
              {
                "type": "text",
                "text": "（1）求零点；（2）写出单调递增区间。"
              }
            ]
          },
          {
            "type": "paragraph",
            "runs": [
              {
                "type": "text",
                "text": "图中红点为 (−1,0)、(1,−4)、(3,0)。"
              }
            ]
          },
          {
            "type": "image",
            "fileId": "17504309-5b4f-4bb8-8919-d78b16322f2d",
