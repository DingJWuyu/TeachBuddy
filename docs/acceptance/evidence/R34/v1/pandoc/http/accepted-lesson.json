        {
          "id": "542ef49c-ffde-4f6f-8dfa-87eab9b843c7",
          "kind": "question",
          "questionId": "f1de5980-53b4-4ce2-be34-5ab12fd64717",
          "questionVersion": 1,
          "note": "",
          "snapshot": {
            "title": "W-Q2 独立材料",
            "body": {
              "version": 2,
              "blocks": [
                {
                  "type": "paragraph",
                  "runs": [
                    {
                      "type": "text",
                      "text": "已知 "
                    },
                    {
                      "type": "math",
                      "latex": "f(x)={x}^{2}-2x-3"
                    },
                    {
                      "type": "text",
                      "text": "，配坐标轴与抛物线图，标出顶点和两个横轴交点。"
                    }
                  ]
                },
                {
                  "type": "list",
                  "role": "subquestions",
                  "items": [
                    {
                      "label": "1",
                      "blocks": [
                        {
                          "type": "paragraph",
                          "runs": [
                            {
                              "type": "text",
                              "text": "求零点"
                            }
                          ]
                        }
                      ]
                    },
                    {
                      "label": "2",
                      "blocks": [
                        {
                          "type": "paragraph",
                          "runs": [
                            {
                              "type": "text",
                              "text": "写出单调递增区间。"
                            }
                          ]
                        }
                      ]
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "runs": [
                    {
                      "type": "text",
                      "text": "图中红点为 "
                    },
                    {
                      "type": "math",
                      "latex": "(-1,0)"
                    },
                    {
                      "type": "text",
                      "text": "、"
                    },
                    {
                      "type": "math",
                      "latex": "(1,-4)"
                    },
                    {
                      "type": "text",
                      "text": "、"
                    },
                    {
                      "type": "math",
                      "latex": "(3,0)"
                    },
                    {
                      "type": "text",
                      "text": "。"
                    }
                  ]
                },
                {
                  "type": "image",
                  "fileId": "2f0f3870-fed4-4c27-8c89-3efd95edfe93",
                  "alt": "原稿配图",
                  "widthMm": 100
                }
              ]
            },
            "solution": {
              "version": 2,
              "blocks": [
                {
                  "type": "paragraph",
                  "runs": [
                    {
                      "type": "text",
                      "text": "解析 "
                    },
                    {
                      "type": "math",
                      "latex": "f(x)=(x-1)^{2}-4"
                    },
                    {
                      "type": "text",
                      "text": "；零点为 −1、3；单调递增区间为 "
                    },
                    {
                      "type": "math",
                      "latex": "[1,+\\infty )"
                    },
                    {
                      "type": "text",
                      "text": "。"
                    }
                  ]
                }
              ]
            },
            "answerStatus": "present"
          },
          "latestVersion": 1,
          "sourceState": "active"
        },
        {
          "id": "f4a42030-d777-4094-9a2a-6f37a6c00f94",
          "kind": "question",
          "questionId": "98c42feb-611f-43ee-91ce-b8b205ae9857",
          "questionVersion": 1,
          "note": "",
          "snapshot": {
            "title": "W-Q3 独立材料",
            "body": {
              "version": 2,
              "blocks": [
                {
                  "type": "paragraph",
                  "runs": [
                    {
                      "type": "math",
                      "latex": "f(x)=\\begin{cases}ax+1 & x<0 \\\\ {x}^{2}-1 & x\\ge 0\\end{cases}"
                    },
                    {
                      "type": "text",
                      "text": "。若 "
                    },
                    {
                      "type": "math",
                      "latex": "f(-2)=3"
                    },
                    {
                      "type": "text",
                      "text": "，求 a 和 "
                    },
                    {
                      "type": "math",
                      "latex": "f(1)"
                    },
                    {
                      "type": "text",
                      "text": "。"
                    }
                  ]
                }
              ]
            },
            "solution": {
              "version": 2,
              "blocks": [
                {
                  "type": "paragraph",
                  "runs": [
                    {
                      "type": "text",
                      "text": "答案 "
                    },
                    {
                      "type": "math",
                      "latex": "a=-1"
                    },
                    {
                      "type": "text",
                      "text": "，"
                    },
                    {
                      "type": "math",
                      "latex": "f(1)=0"
                    },
                    {
                      "type": "text",
                      "text": "。代入负数分支求 a，再代入非负分支。"
                    }
                  ]
                }
              ]
            },
            "answerStatus": "present"
          },
          "latestVersion": 1,
          "sourceState": "active"
        },
        {
          "id": "429fb7f6-bd55-4030-ab93-ba4819367029",
          "kind": "question",
          "questionId": "03dfa1b6-fd3b-4fff-a6bc-88e5dfcba009",
